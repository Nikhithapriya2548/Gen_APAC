{
  "entities": {
    "Journal": {
      "title": "Journal",
      "description": "A user's reflective journal session entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the journal entry"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the owner user"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the journal session"
        },
        "summary": {
          "type": "string",
          "maxLength": 5000,
          "description": "AI-generated or user-provided summary of the reflection"
        },
        "mood": {
          "type": "string",
          "maxLength": 60,
          "description": "Dominant emotional tone/mood detected"
        },
        "topics": {
          "type": "array",
          "description": "Key topics and themes discussed"
        },
        "insights": {
          "type": "string",
          "maxLength": 5000,
          "description": "Deep personalized takeaways from the session"
        },
        "actionItems": {
          "type": "array",
          "description": "Practical next steps identified"
        },
        "reflectionQuestion": {
          "type": "string",
          "maxLength": 1000,
          "description": "Thought-provoking follow-up question for future reflection"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when entry was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when entry was last updated"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "JournalMessage": {
      "title": "JournalMessage",
      "description": "An individual conversation turn between the user and Gemini in a journal",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the message"
        },
        "journalId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of parent journal"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of author user"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"],
          "description": "Speaker role: user or model (Gemini)"
        },
        "content": {
          "type": "string",
          "maxLength": 10000,
          "description": "Text content of the message"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the message"
        }
      },
      "required": ["id", "journalId", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}/journals/{journalId}": {
      "schema": "Journal",
      "description": "Collection of journal entries isolated per user"
    },
    "/users/{userId}/journals/{journalId}/messages/{messageId}": {
      "schema": "JournalMessage",
      "description": "Subcollection of multi-turn conversational messages between user and Gemini within a journal"
    }
  }
}
